# Delsi Chews — Medusa backend environment template
# Copy to .env for local dev. Never commit real secrets (docs/build-pack/09_SECURITY.md).
# Separate values per environment (development / staging / production) — see
# docs/build-pack/11_DEPLOYMENT_OPERATIONS.md.

NODE_ENV=development

# --- Stage 1: commerce foundation (required now) ---
DATABASE_URL=postgres://delsi:delsi_dev_only@127.0.0.1:5432/delsi_medusa
REDIS_URL=redis://127.0.0.1:6379
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,http://localhost:3000
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# --- Stage 5: payments (Razorpay) — not required until checkout is built ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Stage 6: shipping (Shiprocket) — not required until fulfillment is built ---
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=

# --- Stage 7/9: WhatsApp Business API — not required until customer messaging is built ---
# WHATSAPP_BUSINESS_API_TOKEN=
# WHATSAPP_BUSINESS_PHONE_ID=

# --- transactional email — not required until Stage 5/6 confirmations are built ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# --- Stage 9: analytics — not required until marketing/analytics stage ---
# GA4_MEASUREMENT_ID=
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# GOOGLE_ADS_CONVERSION_ID=

# --- Stage 11: monitoring ---
# SENTRY_DSN=
